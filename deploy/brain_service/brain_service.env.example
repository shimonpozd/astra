# Copy this file to brain_service.env and fill in the real values before
# running `docker compose up`.  The format mirrors brain_service/.env.example.

BRAIN_PORT=7030
REDIS_URL=redis://redis:6379/0
ADMIN_TOKEN=change-me
DATABASE_URL=postgresql+asyncpg://astra:astra@postgres:5432/astra_brain
JWT_SECRET=super-secret-jwt
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Uncomment and configure credentials for the providers you enable.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
